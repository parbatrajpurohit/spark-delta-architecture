function hasChanges() {
	test -n "$(git status -s -uno .)"
}

function getRelease() {
	awk -F= '/^release=/{print $2}' .release
}

function getDockerVersion() {
	result=$(getRelease)

	if differsFromRelease; then
		result="$result-$(git log -n 1 --format=%h .)"
	fi

	if hasChanges ; then
		result="$result-dirty"
	fi
	echo $result
}

function getGitTag() {
	result="v$(getRelease)"

	if differsFromRelease; then
		result="$result-$(git log -n 1 --format=%h .)"
	fi

	echo $result
}

function tagExists() {
	tag=$1
	test -n "$tag" && test -n "$(git tag | grep "^$tag\$")"
}

function differsFromRelease() {
	tag=$1
	! tagExists $tag || test -n "$(git diff --shortstat -r $tag .)"
}

function releaseNotesUpdated() {
	tag=$1
	grep "^## \[$tag\]" release_notes.md
}

